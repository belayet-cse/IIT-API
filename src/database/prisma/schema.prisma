// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ALUMNI
  GENERAL
  PREMIUM
  RESEARCHER
}

enum MembershipTier {
  BASIC
  PRO
  ELITE
}

enum AlumniVerificationStatus {
  NONE
  PENDING
  VERIFIED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlumniType {
  AUTOMATIC
  HONORARY
}

enum PaymentType {
  MEMBERSHIP
  BLOG
  RESEARCH
  PROGRAM
}

enum ProgramType {
  INTERNATIONAL
  PROPRIETARY
}

enum PaymentCurrency {
  BDT
  USD
}

enum PaymentGateway {
  SSLCOMMERZ
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum Certification {
  CDCS
  CSDG
  CITF
  CTFP
  OTHER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model MembershipPlan {
  tier            MembershipTier @id
  displayName     String
  priceBdt        Int
  priceUsd        Int
  discountPercent Int            @default(0)
  updatedAt       DateTime       @updatedAt

  @@map("membership_plans")
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              PaymentType
  membershipTier    MembershipTier?
  blogId            String?
  blog              Blog?           @relation(fields: [blogId], references: [id], onDelete: SetNull)
  paperId           String?
  paper             ResearchPaper?  @relation(fields: [paperId], references: [id], onDelete: SetNull)
  programId         String?
  program           Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  currency          PaymentCurrency
  gateway           PaymentGateway?
  amount            Int
  discountPercent   Int             @default(0)
  status            PaymentStatus   @default(PENDING)
  gatewayReference  String?
  note              String?
  processedByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([blogId])
  @@index([paperId])
  @@index([programId])
  @@map("payments")
}

model User {
  id                        String                    @id @default(uuid())
  name                      String
  email                     String                    @unique
  passwordHash              String
  phone                     String?
  organization              String?
  address                   String?
  role                      Role                      @default(GENERAL)
  emailVerified             Boolean                   @default(false)
  mustChangePassword        Boolean                   @default(false)
  alumniVerificationStatus  AlumniVerificationStatus  @default(NONE)
  desiredMembershipTier     MembershipTier?
  membershipTier            MembershipTier?
  membershipExpiresAt       DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  alumniProfile       AlumniProfile?
  passwordResetTokens PasswordResetToken[]
  blogs               Blog[]
  payments            Payment[]
  forumThreads        ForumThread[]
  forumPosts          ForumPost[]
  researchPapers      ResearchPaper[]
  programs            Program[]
  enrollments         Enrollment[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model AlumniApplication {
  id               String            @id @default(uuid())
  fullName         String
  email            String
  phone            String
  linkedin         String?
  designation      String
  organization     String
  yearsExperience  String?
  careerStage      String?
  certification    Certification
  yearCompleted    String
  proofFileUrl     String?
  status           ApplicationStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  createdAt        DateTime          @default(now())

  alumniProfile AlumniProfile?

  @@index([status])
  @@map("alumni_applications")
}

model ResearcherApplication {
  id               String            @id @default(uuid())
  name             String
  email            String
  organization     String
  currentRole      String
  certifications   String[]          @default([])
  expertiseAreas   String[]          @default([])
  bio              String
  linkedinUrl      String?
  status           ApplicationStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime          @default(now())

  @@index([status])
  @@map("researcher_applications")
}

model AlumniProfile {
  id            String             @id @default(uuid())
  userId        String?            @unique
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  applicationId String?            @unique
  application   AlumniApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  name          String
  email         String         @unique
  phone         String?
  linkedin      String?
  designation   String
  organization  String
  country       String?
  batch         String?
  certification Certification?
  type          AlumniType     @default(AUTOMATIC)
  avatarColor   String?
  photoUrl      String?
  bio           String?

  // Privileges
  certDiscountPercent Int     @default(20)
  freeCertifications  String  @default("none")
  blogAccess          Boolean @default(true)
  forumAccess         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("alumni_profiles")
}

model AlumniPrivilegeDefaults {
  id                  String   @id @default("default")
  certDiscountPercent Int      @default(20)
  blogDiscountPercent Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@map("alumni_privilege_defaults")
}

model Blog {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String
  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  category        String?
  tags            String[]   @default([])
  sequence        Int        @default(0)
  status          BlogStatus @default(PUBLISHED)
  priceBdt        Int        @default(0)
  priceUsd        Int        @default(0)
  views           Int        @default(0)
  readingTime     Int        @default(1)
  authorId        String
  author          User       @relation(fields: [authorId], references: [id])
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments Payment[]

  @@index([status])
  @@index([publishedAt])
  @@index([category, sequence])
  @@map("blogs")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("categories")
}

model ForumThread {
  id             String   @id @default(uuid())
  title          String
  content        String
  category       String?
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  pinned         Boolean  @default(false)
  locked         Boolean  @default(false)
  replyCount     Int      @default(0)
  views          Int      @default(0)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts ForumPost[]

  @@index([category])
  @@index([lastActivityAt])
  @@map("forum_threads")
}

model ForumPost {
  id        String      @id @default(uuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([threadId])
  @@map("forum_posts")
}

model ResearchPaper {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  abstract      String
  content       String
  featuredImage String?
  category      String?
  tags          String[]       @default([])
  status        BlogStatus     @default(DRAFT)
  priceBdt      Int            @default(0)
  priceUsd      Int            @default(0)
  certification Certification?
  readingTime   Int            @default(1)
  views         Int            @default(0)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  payments Payment[]

  @@index([status])
  @@index([publishedAt])
  @@map("research_papers")
}

model Program {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  code          String?
  type          ProgramType
  overview      String
  whoItsFor     String?
  examInfo      String?
  featuredImage String?
  priceBdt      Int           @default(0)
  priceUsd      Int           @default(0)
  freeForBasic  Boolean       @default(false)
  freeForPro    Boolean       @default(false)
  freeForElite  Boolean       @default(false)
  featured      Boolean       @default(false)
  status        BlogStatus    @default(DRAFT)
  authorId      String
  author        User          @relation(fields: [authorId], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  modules     ProgramModule[]
  enrollments Enrollment[]
  payments    Payment[]

  @@index([status])
  @@index([type])
  @@map("programs")
}

model ProgramModule {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  title     String
  videoUrl  String?
  sequence  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@map("program_modules")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, programId])
  @@index([programId])
  @@map("enrollments")
}
